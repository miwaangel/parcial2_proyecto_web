# Opcional para Docker: copia este archivo como .env en la raiz del proyecto
#   cp .env.docker.example .env
# Si no existe .env, docker compose usa los valores por defecto (llaves de PRUEBA).

# Puertos en tu computadora (cambialos si ya estan ocupados)
API_PORT=3000
WEB_PORT=5173

# Secreto para firmar los tokens de sesion
JWT_SECRET=cambia_este_secreto_por_un_texto_largo

# reCAPTCHA v2 ("No soy un robot"). Por defecto, las llaves de PRUEBA de Google.
# Pon aqui las reales: la del sitio (publica) y la secreta. Nunca subas este .env a GitHub.
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
