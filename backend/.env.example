# Servidor
PORT=3000
NODE_ENV=development
# URL del frontend (Vite) que puede llamar a la API
CORS_ORIGIN=http://localhost:5173

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ticket_turno
DB_USER=root
DB_PASSWORD=

# Autenticación
JWT_SECRET=cambia_esto_por_un_texto_largo
JWT_EXPIRES_IN=8h

# Google reCAPTCHA v2 (llave SECRETA, nunca va en el front)
# Esta es la llave de PRUEBA de Google: siempre aprueba. Cambiarla por la real al registrar el sitio.
RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Usuario administrador que crea el seeder (npm run db:seed)
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=Admin123!
